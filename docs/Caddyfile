{
	auto_https off
}

:{$PORT:80} {
	root * /usr/share/caddy
	encode zstd gzip

	@install path /install.sh
	header @install Cache-Control "public, max-age=300"
	header @install Content-Type "text/x-shellscript; charset=utf-8"

	@immutable path /_astro/* /landing/* /icons/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	header {
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://umami.getrenart.com; connect-src 'self' https://umami.getrenart.com"
		Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	# Runtime substitution keeps the public legal identity out of Git and provides
	# the Umami website ID to the consent controller. The tracker itself is never
	# emitted by Caddy; browser code creates it only after affirmative consent.
	templates {
		mime text/html
		# Keep documentation examples that use Go/Jinja's {{ ... }} syntax
		# from being interpreted as server-side templates.
		between [[RENART RENART]]
	}

	file_server
}
