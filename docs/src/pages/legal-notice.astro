---
import LegalLayout from '../layouts/LegalLayout.astro';

const runtimeValue = (name: string, buildValue?: string) =>
  buildValue?.trim() || `[[RENART env \`${name}\` | html RENART]]`;

const legalName = runtimeValue('RENART_LEGAL_NAME', import.meta.env.PUBLIC_RENART_LEGAL_NAME);
const addressLine = runtimeValue(
  'RENART_LEGAL_ADDRESS_LINE_1',
  import.meta.env.PUBLIC_RENART_LEGAL_ADDRESS_LINE_1,
);
const postalCode = runtimeValue(
  'RENART_LEGAL_POSTAL_CODE',
  import.meta.env.PUBLIC_RENART_LEGAL_POSTAL_CODE,
);
const city = runtimeValue('RENART_LEGAL_CITY', import.meta.env.PUBLIC_RENART_LEGAL_CITY);
const country = runtimeValue(
  'RENART_LEGAL_COUNTRY',
  import.meta.env.PUBLIC_RENART_LEGAL_COUNTRY,
);
const email = runtimeValue('RENART_LEGAL_EMAIL', import.meta.env.PUBLIC_RENART_LEGAL_EMAIL);
---

<LegalLayout
  title="Legal notice"
  description="Provider identification and contact information for getrenart.com."
  alternateHref="/impressum/"
>
  <p>
    <strong>Translation notice:</strong> This English version is provided for convenience. In
    the event of discrepancies, the <a href="/impressum/" hreflang="de">German version</a>
    applies.
  </p>

  <h2>Provider</h2>
  <address>
    <strong>{legalName}</strong><br />
    {addressLine}<br />
    {postalCode} {city}<br />
    {country}
  </address>

  <h2>Contact</h2>
  <p>Email: <strong>{email}</strong></p>

  <h2>Legal classification</h2>
  <p>
    Information pursuant to section 18(1) of the German State Media Treaty
    (Medienstaatsvertrag) and, where applicable to this website, section 5 of the German
    Digital Services Act (Digitale-Dienste-Gesetz). This website does not contain
    journalistic-editorial content within the meaning of section 18(2) of the German State
    Media Treaty.
  </p>

  <h2>Consumer dispute resolution</h2>
  <p>
    We are neither obliged nor willing to participate in dispute resolution proceedings
    before a consumer arbitration board.
  </p>
</LegalLayout>
