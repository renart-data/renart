---
import { execSync } from 'node:child_process';
import { Font } from 'astro:assets';
import PrivacyConsent from '../components/PrivacyConsent.astro';

const repoUrl = 'https://github.com/renart-data/renart';
const discordUrl = 'https://discord.gg/jTH758KNP8';
const installCommand = 'curl -LsSf getrenart.com/install.sh | sh';
const siteUrl = 'https://getrenart.com';
const pageTitle = 'Renart public alpha - The whole data platform, in the box';
const pageDescription = 'Renart is the whole data platform in one open-source package: editor, notebooks, scheduler, catalog, and staleness tracking, working on plain SQL and Python files in your git repo and running on the warehouse you already use.';
const socialImage = `${siteUrl}/landing/og-image.png`;

function readGitValue(command: string, fallback: string) {
  try {
    return execSync(command, { cwd: new URL('../../..', import.meta.url), stdio: ['ignore', 'pipe', 'ignore'] })
      .toString()
      .trim() || fallback;
  } catch {
    return fallback;
  }
}

function normalizeVersion(value: string | undefined | null) {
  const trimmed = value?.trim();
  return trimmed && trimmed !== 'local build' ? trimmed : null;
}

async function readLatestPublishedVersion() {
  const headers = {
    Accept: 'application/vnd.github+json',
    'User-Agent': 'renart-docs-build',
  };

  try {
    const releaseResponse = await fetch('https://api.github.com/repos/renart-data/renart/releases/latest', { headers });
    if (releaseResponse.ok) {
      const release = await releaseResponse.json();
      const version = normalizeVersion(release?.tag_name);
      if (version) {
        return version;
      }
    }
  } catch {
    // Fall through to tag-based and local fallbacks.
  }

  try {
    const tagsResponse = await fetch('https://api.github.com/repos/renart-data/renart/tags?per_page=1', { headers });
    if (tagsResponse.ok) {
      const tags = await tagsResponse.json();
      const version = normalizeVersion(tags?.[0]?.name);
      if (version) {
        return version;
      }
    }
  } catch {
    // Fall through to local fallback.
  }

  return normalizeVersion(readGitValue('git describe --tags --abbrev=0', '0.0.0')) ?? '0.0.0';
}

const explicitVersion = normalizeVersion(process.env.RENART_VERSION);
const latestVersion = explicitVersion ?? await readLatestPublishedVersion();
const currentYear = new Date().getFullYear();
const landingStructuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: 'Renart',
      url: siteUrl,
      logo: `${siteUrl}/icons/icon.svg`,
      sameAs: [repoUrl, discordUrl],
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Renart',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Linux, macOS, Windows',
      softwareVersion: latestVersion,
      license: 'https://www.apache.org/licenses/LICENSE-2.0',
      url: siteUrl,
      codeRepository: repoUrl,
      description: pageDescription,
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
    },
    {
      '@type': 'WebSite',
      name: 'Renart',
      url: siteUrl,
      description: pageDescription,
      publisher: {
        '@type': 'Organization',
        name: 'Renart',
      },
    },
  ],
});

const stackItems = ['DuckDB', 'Postgres', 'Snowflake', 'BigQuery', 'Redshift', 'S3', 'HTTP APIs', 'Git'];
---

<!doctype html>
<html lang="en">
