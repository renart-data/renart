---
import { execSync } from 'node:child_process';
import { Font } from 'astro:assets';
import { publicMediaUrl } from '../lib/public-media.mjs';
import DiscordInvite from '../components/DiscordInvite.astro';
import PrivacyConsent from '../components/PrivacyConsent.astro';
import MarketingHeader from '../components/MarketingHeader.astro';
import MarketingTheme from '../components/MarketingTheme.astro';
import ThemedScreenshot from '../components/ThemedScreenshot.astro';
import MarketingFooter from '../components/MarketingFooter.astro';
import '../styles/landing.css';

const repoUrl = 'https://github.com/renart-data/renart';
const discordUrl = 'https://discord.gg/jTH758KNP8';
const installCommand = 'curl -LsSf getrenart.com/install.sh | sh';
const siteUrl = 'https://getrenart.com';
const pageTitle = 'Renart — Open source data platform · Public alpha';
const pageDescription = 'An open source data platform for moving, transforming and analyzing data. SQL and Python pipelines, notebooks and dashboards, defined as code in Git. Public alpha.';
const socialImage = siteUrl + publicMediaUrl('/landing/og-image.png');

function readGitValue(command: string, fallback: string) {
  try {
    return execSync(command, {
      cwd: new URL('../../..', import.meta.url),
      stdio: ['ignore', 'pipe', 'ignore'],
    }).toString().trim() || fallback;
  } catch {
    return fallback;
  }
}

function normalizeVersion(value: string | undefined | null) {
  const trimmed = value?.trim();
  return trimmed && trimmed !== 'local build' ? trimmed : null;
}

async function readLatestPublishedVersion() {
  const headers = {
    Accept: 'application/vnd.github+json',
    'User-Agent': 'renart-docs-build',
  };

  try {
    const releaseResponse = await fetch(
      'https://api.github.com/repos/renart-data/renart/releases/latest',
      { headers },
    );
    if (releaseResponse.ok) {
      const release = await releaseResponse.json();
      const version = normalizeVersion(release?.tag_name);
      if (version) return version;
    }
  } catch {
    // Fall through to tag-based and local fallbacks.
  }

  try {
    const tagsResponse = await fetch(
      'https://api.github.com/repos/renart-data/renart/tags?per_page=1',
      { headers },
    );
    if (tagsResponse.ok) {
      const tags = await tagsResponse.json();
      const version = normalizeVersion(tags?.[0]?.name);
      if (version) return version;
    }
  } catch {
    // Fall through to the local fallback.
  }

  return normalizeVersion(
    readGitValue('git describe --tags --abbrev=0', '0.0.0'),
  ) ?? '0.0.0';
}

const explicitVersion = normalizeVersion(process.env.RENART_VERSION);
const latestVersion = explicitVersion ?? await readLatestPublishedVersion();
const landingStructuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: 'Renart',
      url: siteUrl,
      logo: siteUrl + '/icons/icon.svg',
      sameAs: [repoUrl, discordUrl],
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Renart',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Linux, macOS, Windows',
      softwareVersion: latestVersion,
      license: 'https://www.apache.org/licenses/LICENSE-2.0',
      url: siteUrl,
      codeRepository: repoUrl,
      description: pageDescription,
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
    },
    {
      '@type': 'WebSite',
      name: 'Renart',
      url: siteUrl,
      description: pageDescription,
      publisher: {
        '@type': 'Organization',
        name: 'Renart',
      },
    },
  ],
});

const lifecycleStages = [
  {
    label: 'Load',
    title: 'Bring data into the workflow.',
    description: 'Choose a source, destination and load mode in the workspace. Make the transfer part of the pipeline, alongside its transformations.',
    detail: 'Databases, files and object storage',
    image: '/docs-media/load-asset.webp',
    alt: 'Renart Load asset editor with source, destination and loading options',
    width: 2800,
    height: 1800,
    href: '/docs/asset-types/load-assets/',
  },
  {
    label: 'Build',
    title: 'See the pipeline while you write it.',
    description: 'Keep the Explorer, pipeline-aware editor, live canvas, data preview, and asset workbench in one view.',
    detail: 'SQL + Python · IntelliSense · validation',
    image: '/docs-media/workspace-overview.webp',
    alt: 'The Renart Build view with the Explorer, editor, pipeline canvas, preview, and asset workbench visible together',
    width: 3200,
    height: 2000,
    href: '/docs/workspace/interface-tour/',
  },
  {
    label: 'Lineage',
    title: 'Follow the effect of a change.',
    description: 'See which assets depend on each other. Review changed definitions and downstream staleness before choosing what to rebuild.',
    detail: 'Dependencies · changed definitions · downstream impact',
    image: '/docs-media/pipeline-canvas.webp',
    alt: 'The Renart pipeline canvas showing asset dependencies and freshness states',
    width: 2800,
    height: 1800,
    href: '/docs/workspace/pipeline-canvas/',
  },
  {
    label: 'Notebook',
    title: 'Explore before you make it permanent.',
    description: 'Mix SQL, Python, text, controls, and charts locally, then promote useful work into a pipeline asset.',
    detail: 'SQL + Python · controls · checked charts',
    image: '/docs-media/notebook.webp',
    alt: 'A Renart notebook combining a query, result table, controls, and a chart',
    width: 3000,
    height: 1920,
    href: '/docs/notebooks/overview/',
  },
  {
    label: 'Dashboard',
    title: 'Turn typed datasets into a dashboard.',
    description: 'Compose KPIs, tables, charts, and controls visually while keeping the definition version-controlled.',
    detail: 'Dashboards · filters · typed datasets',
    image: '/docs-media/dashboard-builder.webp',
    alt: 'The Renart dashboard builder with KPIs, charts, tables, and the component rail',
    width: 3000,
    height: 1920,
    href: '/docs/presentations/overview/',
  },
  {
    label: 'Report',
    title: 'Keep the narrative beside the evidence.',
    description: 'Combine Markdown, checked visualizations, and tables in a report stored with the rest of the project.',
    detail: 'Markdown · charts · tables',
    image: '/docs-media/report-builder.webp',
    alt: 'The Renart report builder combining narrative text, tables, and checked charts',
    width: 3000,
    height: 1920,
    href: '/docs/presentations/overview/',
  },
  {
    label: 'Schedule',
    title: 'Run a reviewed snapshot on a schedule.',
    description: 'Choose the pipeline, environment, cron, timezone, and catch-up policy, then keep that deployment pinned until you advance it.',
    detail: 'Cron · environments · pinned deployments',
    image: '/docs-media/schedules.webp',
    alt: 'The Renart schedules view with pipeline environments, cron cadence, deployments, and upcoming runs',
    width: 2800,
    height: 1520,
    href: '/docs/scheduling/overview/',
  },
  {
    label: 'Runs',
    title: 'Understand what happened in a run.',
    description: 'Inspect per-asset timing, status, events, output, and the exact error attached to a failed run.',
    detail: 'Run timeline · logs · exact errors',
    image: '/docs-media/run-detail.webp',
    alt: 'A Renart run detail with per-asset timing, status, events, and the error for a failed asset',
    width: 2800,
    height: 1800,
    href: '/docs/workspace/runs-and-history/',
  },
] as const;

const platforms = [
  'DuckDB',
  'Postgres',
  'ClickHouse',
  'StarRocks',
  'Trino',
  'Snowflake',
  'BigQuery',
  'Redshift',
  'Databricks',
  'S3 / GCS',
  'HTTP APIs',
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <meta name="application-name" content="Renart" />
    <meta name="apple-mobile-web-app-title" content="Renart" />
    <meta name="theme-color" content="#f8f8f4" />
    <MarketingTheme />
    <meta name="robots" content="index, follow" />
    <meta
      name="keywords"
      content="Renart, data platform, ETL, ELT, data pipelines, data lineage, SQL editor, Python data pipelines, SQL notebooks, git-native data pipelines, data engineering, analytics engineering"
    />
    <meta name="author" content="Renart" />
    <link rel="icon" href="/icons/icon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" sizes="180x180" />
    <link rel="canonical" href={siteUrl} />
    <link rel="sitemap" type="application/xml" href={siteUrl + '/sitemap-index.xml'} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Renart" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={siteUrl + '/'} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="675" />
    <meta
      property="og:image:alt"
      content="The Renart workspace with a pipeline canvas and SQL editor side by side"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta
      name="twitter:image:alt"
      content="The Renart workspace with a pipeline canvas and SQL editor side by side"
    />
    <script is:inline type="application/ld+json" set:html={landingStructuredData}></script>
    <title>{pageTitle}</title>
    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-geist-mono" />
    <Font cssVariable="--font-instrument-serif" preload />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <MarketingHeader />

    <main id="main">
      <section id="top" class="landing-hero">
        <div class="landing-container">
          <div class="landing-hero__intro">
            <div>
              <p class="landing-eyebrow">Open source data platform</p>
              <h1>Build data workflows<br class="desktop-break" /> you can maintain.</h1>
              <div class="hero-install" aria-label="Install Renart">
                <div class="hero-install__heading"><span>Install Renart</span><a href="/docs/installation/">Installation options <span aria-hidden="true">↗</span></a></div>
                <div class="hero-install__command">
                  <code>{installCommand}</code>
                  <button class="hero-install__copy" type="button" data-copy-command={installCommand} aria-label="Copy Renart install command">
                    <svg viewBox="0 0 20 20" width="17" height="17" fill="none" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2" stroke="currentColor" stroke-width="1.5" /><path d="M12 4V3H3v9h1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    <span data-copy-label>Copy</span>
                  </button>
                </div>
              </div>
              <div class="landing-actions">
                <a class="landing-text-link" href="/docs/quickstart/">Build your first pipeline <span aria-hidden="true">↗</span></a>
                <a class="landing-text-link landing-github-link" href={repoUrl}><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><path d="m12 3 2.8 5.7 6.3.9-4.55 4.45 1.07 6.28L12 17.36l-5.62 2.97 1.07-6.28L2.9 9.6l6.3-.9Z" /></svg>Star us on GitHub</a>
              </div>
              <p class="landing-status"><span>Public alpha</span> Apache 2.0 · Runs locally</p>
            </div>
            <div class="landing-hero__description">
              <p>Renart is an open source data platform for moving, transforming and analyzing data across your data stack.</p>
              <p>Build and run SQL and Python pipelines alongside notebooks and dashboards in one visual workspace, with type checking, scheduling and everything defined as code in Git.</p>
              <a class="landing-text-link landing-hero__tour" href="#lifecycle">Take a look inside <span aria-hidden="true">↓</span></a>
            </div>
          </div>

          <figure class="workspace-hero">
            <div class="workspace-hero__bar"><span>The Renart workspace</span><span>Code, dependencies and results</span></div>
            <ThemedScreenshot src="/landing/hero-workspace.webp" widths={[480, 768, 1280, 1920]}
              sizes="(max-width: 48rem) calc(100vw - 2.5rem), (max-width: 78rem) calc(100vw - 5rem), 1168px"
              alt="Renart showing the SQL editor, connected pipeline assets and a table of inspected results in one workspace"
              width={3840} height={2160} eager zoomLabel="Open the Renart workspace image at full size" />
            <figcaption>Write the code, follow its dependencies and inspect the data without losing your place.</figcaption>
          </figure>
          <p class="landing-alpha-note">Renart is in public alpha. Expect rough edges and changes before the first stable release. <a href="/docs/alpha-status/">What to expect <span aria-hidden="true">↗</span></a></p>
        </div>
      </section>

      <section class="workflow-section section-space" aria-labelledby="workflow-title">
        <div class="landing-container">
          <div class="section-heading">
            <p class="landing-eyebrow">The entire data workflow</p>
            <h2 id="workflow-title">From getting data in<br /> to putting it to work.</h2>
          </div>
          <div class="workflow-columns">
            <article>
              <span class="section-number" aria-hidden="true">01 / MOVE</span>
              <h3>Bring the data together.</h3>
              <p>Load from databases, files, object storage and HTTP APIs. Move data into and out of supported warehouses as part of the pipeline.</p>
              <a class="landing-text-link" href="/docs/asset-types/load-assets/">Data loading <span aria-hidden="true">↗</span></a>
            </article>
            <article>
              <span class="section-number" aria-hidden="true">02 / TRANSFORM</span>
              <h3>Build with SQL and Python.</h3>
              <p>Develop transformations with type checking and intelligent completion. Connect the assets, inspect the results and schedule the work.</p>
              <a class="landing-text-link" href="/docs/editing-assets/asset-editor/">Pipeline development <span aria-hidden="true">↗</span></a>
            </article>
            <article>
              <span class="section-number" aria-hidden="true">03 / ANALYZE</span>
              <h3>Make the results useful.</h3>
              <p>Explore data in notebooks and build dashboards and reports. Keep the analysis and its definitions alongside the pipelines in Git.</p>
              <a class="landing-text-link" href="/docs/notebooks/overview/">Notebooks and analysis <span aria-hidden="true">↗</span></a>
            </article>
          </div>
        </div>
      </section>

      <section id="product" class="development-section section-space" aria-labelledby="development-title">
        <div class="landing-container">
          <div class="development-grid">
            <div class="development-copy">
              <p class="landing-eyebrow">Built for the next change</p>
              <h2 id="development-title">Make changes<br /> with context.</h2>
              <p class="section-lede">A pipeline is easier to maintain when the code, dependencies and results are in view together.</p>
              <a class="landing-text-link" href="/docs/editing-assets/asset-editor/">Explore the asset editor <span aria-hidden="true">↗</span></a>
            </div>
            <figure class="editor-proof">
              <ThemedScreenshot src="/landing/lifecycle-build.webp" widths={[480, 768, 1280]}
                sizes="(max-width: 48rem) calc(100vw - 2.5rem), (max-width: 78rem) 58vw, 700px"
                alt="SQL completion in Renart suggesting customer columns and their types from an upstream asset"
                width={1820} height={880} />
              <figcaption>Completion uses the tables and columns your pipeline knows about.</figcaption>
            </figure>
          </div>
          <div class="development-principles">
            <article>
              <h3>Catch mistakes while you edit.</h3>
              <p>Get SQL and Python diagnostics and completion in the editor. Check known columns and types before running against your database.</p>
            </article>
            <article>
              <h3>See what a change affects.</h3>
              <p>Follow dependencies on the canvas. Staleness highlights changed definitions and downstream assets that may need rebuilding.</p>
            </article>
            <article>
              <h3>Review before you run.</h3>
              <p>Preview SQL results with Inspect, review the file diff and choose what to materialize. Scheduled runs use a deployed snapshot.</p>
            </article>
          </div>
        </div>
      </section>

      <section id="lifecycle" class="workspace-section section-space" aria-labelledby="workspace-title">
        <div class="landing-container">
          <div class="section-heading workspace-section__heading">
            <div>
              <p class="landing-eyebrow">One workspace, shared definitions</p>
              <h2 id="workspace-title">Build, explore and run<br /> in one workspace.</h2>
            </div>
            <p>Move between pipelines, notebooks and scheduled runs with the same assets, schemas and dependencies.</p>
          </div>
          <div class="workspace-tabs" role="tablist" aria-label="Renart workspace views">
            {lifecycleStages.map((stage, index) => (
              <button
                id={`workspace-tab-${index}`}
                class="workspace-tab"
                type="button"
                role="tab"
                aria-selected={index === 0 ? 'true' : 'false'}
                aria-controls="workspace-panel"
                tabindex={index === 0 ? 0 : -1}
                data-stage-button
                data-label={stage.label}
                data-title={stage.title}
                data-description={stage.description}
                data-detail={stage.detail}
                data-image={publicMediaUrl(stage.image)}
                data-image-light={publicMediaUrl(stage.image.replace(/\.webp$/, '-light.webp'))}
                data-alt={stage.alt}
                data-width={stage.width}
                data-height={stage.height}
                data-href={stage.href}
              >{stage.label}</button>
            ))}
          </div>
          <article id="workspace-panel" class="workspace-panel" role="tabpanel" aria-labelledby="workspace-tab-0" tabindex="0">
            <div class="workspace-panel__copy">
              <p class="landing-eyebrow" data-stage-eyebrow>{lifecycleStages[0].label}</p>
              <h3 data-stage-title>{lifecycleStages[0].title}</h3>
              <p data-stage-description>{lifecycleStages[0].description}</p>
              <p class="workspace-panel__detail" data-stage-detail>{lifecycleStages[0].detail}</p>
              <a class="landing-text-link" href={lifecycleStages[0].href} data-stage-link>Read the docs <span aria-hidden="true">↗</span></a>
            </div>
            <figure class="workspace-panel__media">
              <ThemedScreenshot src={lifecycleStages[0].image} alt={lifecycleStages[0].alt}
                width={lifecycleStages[0].width} height={lifecycleStages[0].height} stage
                zoomLabel="Open the selected workspace image at full size" />
              <figcaption>Actual Renart interface <span>Open image to see the details <span aria-hidden="true">↗</span></span></figcaption>
            </figure>
          </article>
          <noscript><p class="workspace-fallback">The <a href="/docs/workspace/interface-tour/">interface tour</a> covers the workspace views without this interactive preview.</p></noscript>
        </div>
      </section>

      <section id="platform" class="platform-section section-space" aria-labelledby="platform-title">
        <div class="landing-container">
          <div class="section-heading">
            <p class="landing-eyebrow">Local first. Defined in Git.</p>
            <h2 id="platform-title">Your infrastructure.<br /> Your repository.</h2>
          </div>
          <div class="platform-grid">
            <article class="platform-connections">
              <h3>Work with the stack you have.</h3>
              <p>Start locally with DuckDB or connect to your databases and warehouses. Bring in files, object storage and HTTP API data where the workflow needs it.</p>
              <ul class="platform-list" aria-label="Supported platforms and sources">
                {platforms.map((platform) => <li>{platform}</li>)}
              </ul>
              <a class="landing-text-link" href="/docs/connections-environments/managing-connections/">Connections and environments <span aria-hidden="true">↗</span></a>
            </article>
            <div class="platform-details">
              <article>
                <h3>Keep the work reviewable.</h3>
                <p>Pipelines, notebooks, dashboards, reports and schedule definitions are plain files. Visual edits become changes you can review, commit and revert in Git.</p>
                <a class="landing-text-link" href="/docs/how-it-works/">How Renart stores your work <span aria-hidden="true">↗</span></a>
              </article>
              <article>
                <h3>Run it in your environment.</h3>
                <p>No Renart account or hosted control plane is required. You choose the systems Renart connects to. Credentials and machine-local run history stay separate from authored definitions.</p>
                <a class="landing-text-link" href="/docs/reference/security-and-privacy/">Security and privacy <span aria-hidden="true">↗</span></a>
              </article>
            </div>
          </div>
        </div>
      </section>

      <section id="install" class="closing-section section-space" aria-labelledby="install-title">
        <div class="landing-container closing-grid">
          <div>
            <p class="landing-eyebrow">Start with a local pipeline</p>
            <h2 id="install-title">Put Renart to work.</h2>
            <p>Open a Git repository, build a small pipeline and see how the workflow fits.</p>
            <a class="landing-button" href="/docs/quickstart/">Follow the quickstart <span aria-hidden="true">↗</span></a>
          </div>
          <div class="install-command">
            <span class="install-command__label">Install Renart</span>
            <code>{installCommand}</code>
            <button class="command-copy" type="button" data-copy-command={installCommand} aria-label="Copy Renart install command"><span data-copy-label>Copy command</span></button>
            <a href="/docs/installation/">Installation options for Linux, macOS and Windows <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>
    </main>

    <MarketingFooter version={latestVersion} />
    <div class="copy-toast" role="status" aria-live="polite" data-copy-toast></div>
    <PrivacyConsent />
    <DiscordInvite />

    <script>
      const copyButtons = document.querySelectorAll<HTMLButtonElement>('[data-copy-command]');
      const toast = document.querySelector<HTMLElement>('[data-copy-toast]');
      let toastTimeout: number | undefined;
      async function copyText(value: string) {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(value);
          return;
        }
        const textarea = document.createElement('textarea');
        textarea.value = value;
        textarea.setAttribute('readonly', '');
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.append(textarea);
        textarea.select();
        const execCommand = Reflect.get(document, 'execCommand');
        const copied = typeof execCommand === 'function' && Reflect.apply(execCommand, document, ['copy']);
        textarea.remove();
        if (!copied) throw new Error('Clipboard access is unavailable');
      }
      copyButtons.forEach((button) => {
        button.addEventListener('click', async () => {
          try {
            await copyText(button.dataset.copyCommand ?? '');
            const label = button.querySelector<HTMLElement>('[data-copy-label]');
            const initialLabel = label?.textContent ?? '';
            if (label) label.textContent = 'Copied';
            if (toast) toast.textContent = 'Install command copied';
            window.setTimeout(() => { if (label) label.textContent = initialLabel; }, 1800);
          } catch {
            if (toast) toast.textContent = 'Copy unavailable. Select the command to copy it manually.';
          }
          toast?.classList.add('is-visible');
          if (toastTimeout) window.clearTimeout(toastTimeout);
          toastTimeout = window.setTimeout(() => toast?.classList.remove('is-visible'), 3500);
        });
      });

      const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-stage-button]'));
      const panel = document.querySelector<HTMLElement>('#workspace-panel');
      const image = document.querySelector<HTMLImageElement>('[data-stage-image]');
      const source = document.querySelector<HTMLSourceElement>('[data-stage-source]');
      const link = document.querySelector<HTMLAnchorElement>('[data-stage-link]');
      const fullsize = document.querySelector<HTMLAnchorElement>('[data-stage-fullsize]');
      const fields = [
        ['[data-stage-eyebrow]', 'label'],
        ['[data-stage-title]', 'title'],
        ['[data-stage-description]', 'description'],
        ['[data-stage-detail]', 'detail'],
      ] as const;
      function selectTab(button: HTMLButtonElement) {
        tabs.forEach((tab) => {
          const selected = tab === button;
          tab.setAttribute('aria-selected', String(selected));
          tab.tabIndex = selected ? 0 : -1;
        });
        panel?.setAttribute('aria-labelledby', button.id);
        fields.forEach(([selector, field]) => {
          const element = document.querySelector<HTMLElement>(selector);
          if (element) element.textContent = button.dataset[field] ?? '';
        });
        if (link) link.href = button.dataset.href ?? '/docs/';
        if (image) {
          image.src = button.dataset.imageLight ?? image.src;
          image.alt = button.dataset.alt ?? '';
          image.width = Number(button.dataset.width ?? image.width);
          image.height = Number(button.dataset.height ?? image.height);
        }
        if (source) source.srcset = button.dataset.image ?? source.srcset;
        if (fullsize) {
          fullsize.dataset.lightHref = button.dataset.imageLight ?? '';
          fullsize.dataset.darkHref = button.dataset.image ?? '';
          fullsize.href = document.documentElement.dataset.theme === 'dark'
            ? fullsize.dataset.darkHref : fullsize.dataset.lightHref;
        }
      }
      tabs.forEach((button, index) => {
        button.addEventListener('click', () => selectTab(button));
        button.addEventListener('keydown', (event) => {
          let next: number;
          if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
          else if (event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
          else if (event.key === 'Home') next = 0;
          else if (event.key === 'End') next = tabs.length - 1;
          else return;
          event.preventDefault();
          tabs[next]?.focus();
          if (tabs[next]) selectTab(tabs[next]);
        });
      });

    </script>
  </body>
</html>
