    <link rel="sitemap" type="application/xml" href={`${siteUrl}/sitemap-index.xml`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Renart" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={`${siteUrl}/`} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="675" />
    <meta property="og:image:alt" content="The Renart workspace: pipeline canvas with freshness badges next to a SQL editor" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="The Renart workspace: pipeline canvas with freshness badges next to a SQL editor" />
    <script is:inline type="application/ld+json" set:html={landingStructuredData}></script>
    <title>{pageTitle}</title>
    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-geist-mono" />
    <Font cssVariable="--font-instrument-serif" preload />
  </head>
  <body>
    <header class="nav">
      <div class="nav-inner">
        <a href="/" class="logo" aria-label="Renart home">
          <img
            class="logo-mark"
            src="/icons/icon-32.png"
            srcset="/icons/icon-32.png 1x, /icons/icon-64.png 2x"
            alt=""
            width="22"
            height="22"
          />
          renart
        </a>
        <nav class="nav-links" aria-label="Primary navigation">
          <a class="nav-link" href="#difference">Why Renart</a>
          <a class="nav-link" href="#lifecycle">Lifecycle</a>
          <a class="nav-link" href="#features">Features</a>
          <a class="nav-link" href="#principles">Principles</a>
          <a class="nav-link" href="/docs/">Docs</a>
        </nav>
        <div class="nav-right">
          <a class="nav-stars nav-icon-link" href={repoUrl} aria-label="Renart GitHub project">
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" /></svg>
          </a>
          <a class="nav-cta" href="/docs/installation/">Get started</a>
        </div>
      </div>
    </header>

    <main>
      <section class="hero">
        <span class="hero-eyebrow">
          <span class="pip"></span>
          <strong>{latestVersion}</strong>
          <span class="sep">/</span>
          <strong>public alpha</strong>
          <span class="sep">/</span>
          Open source / Apache 2.0
        </span>

        <h1>
          The whole <span class="stroke">data platform</span>,<br />
          <em>in the box</em>.
        </h1>

        <p class="hero-sub">
          Editor, notebooks, scheduler, catalog, freshness tracking — Renart ships the parts that usually live behind a hosted login in one open-source package, and knows exactly what to rebuild when you change a file. Runs on the warehouse you already use; starts on your laptop with one command.
        </p>

        <p class="alpha-note">
          Renart is in public alpha. Expect rough edges and fast changes before the first stable release — early feedback is very welcome.
        </p>

        <div class="ctas">
          <a href="/docs/installation/" class="btn btn-primary">Get started</a>
          <a href="/docs/" class="btn btn-ghost">Read the docs <span class="arrow">-&gt;</span></a>
        </div>

        <div class="install install-hero" id="install">
          <span class="install-cmd">
            <span class="prompt">$</span>
            <span>{installCommand}</span>
          </span>
          <button class="install-copy" type="button" data-copy-command={installCommand}>
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="4" y="4" width="9" height="9" rx="1.5" stroke="currentColor" stroke-width="1.4" /><path d="M3 11V4a1 1 0 011-1h7" stroke="currentColor" stroke-width="1.4" /></svg>
            <span class="copy-label">copy</span>
          </button>
        </div>

        <div class="hero-media">
          <img
            src="/landing/hero-workspace.webp"
            alt="The Renart workspace: a SQL editor and live pipeline canvas side by side, with fresh and edited status badges on assets, inferred dependencies, and a query preview panel"
            width="1920"
            height="1080"
            srcset="/landing/hero-workspace-480.webp 480w, /landing/hero-workspace-768.webp 768w, /landing/hero-workspace-1280.webp 1280w, /landing/hero-workspace-1920.webp 1920w, /landing/hero-workspace.webp 3840w"
            sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1200px) calc(100vw - 56px), 1144px"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      </section>

      <div class="marquee-wrap" aria-label="Supported data stack examples">
        <div class="marquee-label">Runs on the stack you already have</div>
        <div class="marquee">
          {stackItems.concat(stackItems).map((item) => (
            <span class="marquee-item"><span class="ico"></span>{item}</span>
          ))}
        </div>
      </div>

      <section class="block" id="difference">
        <div class="eyebrow"><span class="bar"></span> The difference</div>
        <h2 class="h2">It knows exactly <em>what changed</em>.</h2>
        <p class="lede">
          Renart fingerprints every asset — its code, its dependencies, its outputs. Edit one model and the canvas shows precisely what went stale downstream; build again and only that set reruns. Incremental builds, for your warehouse.
        </p>

        <div class="diff-media">
          <img
            src="/landing/lifecycle-staleness.webp"
            alt="The Renart pipeline canvas after an edit: the changed staging asset is marked Edited, its downstream marts are marked Upstream changed, a new asset shows Never built, and untouched assets stay Fresh"
            width="1176"
            height="756"
            srcset="/landing/lifecycle-staleness-480.webp 480w, /landing/lifecycle-staleness-768.webp 768w, /landing/lifecycle-staleness-1280.webp 1280w, /landing/lifecycle-staleness.webp 2352w"
            sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1200px) calc(100vw - 56px), 1144px"
            loading="lazy"
            decoding="async"
          />
        </div>

        <div class="diff-points">
          <div class="diff-point">
            <div class="card-tag">Fingerprints</div>
            <h3>Content identity, not timestamps</h3>
            <p>A fingerprint covers the canonicalized SQL, the config, the variables an asset consumes, and every upstream fingerprint. Reformatting changes nothing; a real change invalidates exactly its downstream cone.</p>
          </div>
          <div class="diff-point">
            <div class="card-tag">Staleness</div>
            <h3>State you can see</h3>
            <p>Fresh, edited, upstream changed, never built — every asset wears its state on the canvas, per environment, updated as you work.</p>
          </div>
          <div class="diff-point">
            <div class="card-tag">Builds</div>
            <h3>Rerun only the stale set</h3>
            <p>Building stale assets reruns exactly what an edit invalidated and skips everything that is still fresh — no full-refresh anxiety, no hand-picked node selectors.</p>
          </div>
        </div>
      </section>

      <section class="block" id="lifecycle">
        <div class="eyebrow"><span class="bar"></span> The lifecycle</div>
        <h2 class="h2">One tool, the <em>whole lifecycle</em>.</h2>
        <p class="lede">
          Shipping a pipeline usually means dbt for the SQL, Airflow to schedule it, a catalog to document it, and a freshness dashboard to tell you when it broke — four tools and the glue between them. Renart covers the loop in one place, and everything it does ends up as reviewable files in your repository.
        </p>

        <div class="lifecycle">
          <article class="life-row">
            <div class="life-copy">
              <div class="card-tag">01 · Build</div>
              <h3>Write SQL that knows your pipeline</h3>
              <p>The editor is grounded in your actual DAG. IntelliSense suggests columns from upstream assets, and validation flags unresolved references while you type — so a broken column shows up in the editor, not in tomorrow's failed run.</p>
            </div>
            <div class="life-media">
              <img
                src="/landing/lifecycle-build.webp"
                alt="The Renart editor mid-keystroke: a completion popup lists columns from the upstream raw.customers table, with the column's type shown inline"
                width="910"
                height="585"
                srcset="/landing/lifecycle-build-480.webp 480w, /landing/lifecycle-build-768.webp 768w, /landing/lifecycle-build-1280.webp 1280w, /landing/lifecycle-build.webp 1820w"
                sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1100px) calc(100vw - 56px), 635px"
                loading="lazy"
                decoding="async"
              />
            </div>
          </article>

          <article class="life-row life-row--rev">
            <div class="life-copy">
              <div class="card-tag">02 · Explore</div>
              <h3>Prototype in a notebook, promote what works</h3>
              <p>Every project has SQL notebooks for ad-hoc analysis: query your data and see tables and charts inline. When a query earns a permanent place, promote the cell into a real pipeline asset — same repo, same review flow as everything else.</p>
            </div>
            <div class="life-media">
              <img
                src="/landing/lifecycle-notebook.webp"
                alt="A Renart SQL notebook: a query cell with its result table, a chart cell rendering a revenue line chart, and the cell menu open on the Promote to pipeline action"
                width="1008"
                height="648"
                srcset="/landing/lifecycle-notebook-480.webp 480w, /landing/lifecycle-notebook-768.webp 768w, /landing/lifecycle-notebook-1280.webp 1280w, /landing/lifecycle-notebook.webp 2016w"
                sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1100px) calc(100vw - 56px), 635px"
                loading="lazy"
                decoding="async"
              />
            </div>
          </article>

          <article class="life-row">
            <div class="life-copy">
              <div class="card-tag">03 · Run</div>
              <h3>From first run to production cron</h3>
              <p>Preview any asset without side effects, then materialize it explicitly when you're sure. Put the pipeline on a schedule per environment and Renart executes it against your platform of choice — DuckDB, Postgres, Snowflake, BigQuery, and more. No separate orchestrator to deploy and babysit.</p>
            </div>
            <div class="life-media">
              <img
                src="/landing/lifecycle-schedules.webp"
                alt="The Renart schedules overview: populated pipeline environments show their cron cadence, pinned deployment, latest run state, and upcoming runs on a shared timeline"
                width="1120"
                height="720"
                srcset="/landing/lifecycle-schedules-480.webp 480w, /landing/lifecycle-schedules-768.webp 768w, /landing/lifecycle-schedules-1280.webp 1280w, /landing/lifecycle-schedules.webp 2240w"
                sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1100px) calc(100vw - 56px), 635px"
                loading="lazy"
                decoding="async"
              />
            </div>
          </article>

        </div>
      </section>

      <section class="block" id="features">
        <div class="eyebrow"><span class="bar"></span> And around it</div>
        <h2 class="h2">The parts you'd otherwise <em>bolt on</em>.</h2>

        <div class="bento">
          <article class="card card--feature span-6">
            <div class="card-visual">
              <img
                src="/landing/feature-runs.webp"
                alt="A failed run in Renart: a per-asset execution timeline with one asset in red, and the event log pinpointing the exact SQL error that stopped the run"
                width="1200"
                height="675"
                srcset="/landing/feature-runs-480.webp 480w, /landing/feature-runs-768.webp 768w, /landing/feature-runs-1280.webp 1280w, /landing/feature-runs-1920.webp 1920w, /landing/feature-runs.webp 2400w"
                sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1200px) calc(100vw - 56px), 1144px"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="card-content">
              <div class="card-tag">Runs &amp; history</div>
              <h3>Every run on the record</h3>
              <p>Manual or scheduled, every run is recorded with per-asset status, timing, and logs — so "what happened last night" is a click, not an investigation.</p>
            </div>
          </article>

          <article class="card card--feature span-6">
            <div class="card-visual">
              <img
                src="/landing/feature-catalog.webp"
                alt="The Renart catalog: lineage across every pipeline in the workspace, with one asset selected and its upstream path highlighted through the graph"
                width="1200"
                height="675"
                srcset="/landing/feature-catalog-480.webp 480w, /landing/feature-catalog-768.webp 768w, /landing/feature-catalog-1280.webp 1280w, /landing/feature-catalog-1920.webp 1920w, /landing/feature-catalog.webp 2400w"
                sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1200px) calc(100vw - 56px), 1144px"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="card-content">
              <div class="card-tag">Catalog</div>
              <h3>Your pipeline, documented by default</h3>
              <p>A catalog of every asset across every pipeline — columns, owners, tags, and lineage, generated from the files themselves. Select an asset and trace exactly what feeds it.</p>
            </div>
          </article>

          <article class="card span-3 card--text">
            <div class="card-content">
              <div class="card-tag">Git-native</div>
              <h3>The repo is the product</h3>
              <p>Renart edits ordinary files. Move a node, rename an asset, change a materialization — it all lands as a plain diff your team can branch, review, and revert like any other code.</p>
            </div>
          </article>

          <article class="card span-3 card--text">
            <div class="card-content">
              <div class="card-tag">Quality</div>
              <h3>Checks that ship with the asset</h3>
              <p>Define <code>not_null</code>, <code>unique</code>, accepted values, or custom SQL checks next to the code they guard. They travel with the asset and run with the pipeline.</p>
            </div>
          </article>
        </div>
      </section>

      <section class="manifesto">
        <blockquote>
          Your data stack should not be <em>five tools duct-taped together</em>.
        </blockquote>
        <div class="attrib">The thesis behind Renart</div>
      </section>

      <section class="block principles" id="principles">
        <div class="eyebrow"><span class="bar"></span> How it runs</div>
        <h2 class="h2">Runs where you are. <em>Your files, your warehouse.</em></h2>
        <p class="lede">
          Renart is infrastructure you can actually reason about: a single process on your machine, working on text files in your repository.
        </p>

        <div class="plist">
          <div class="prow"><span class="check">✓</span><span><b>One install.</b> Start <code>renart</code> inside your repository — no services to stand up, nothing to configure first.</span></div>
          <div class="prow"><span class="check">✓</span><span><b>Your data stays in your warehouse.</b> Renart connects to the databases you already run — it is not a platform you load your data into.</span></div>
          <div class="prow"><span class="check">✓</span><span><b>Your platform, your choice.</b> Run pipelines on DuckDB, Postgres, Snowflake, BigQuery, Redshift, and more.</span></div>
          <div class="prow"><span class="check">✓</span><span><b>Everything is readable text.</b> The entire pipeline definition is human-readable, diffable files — nothing hides in a database.</span></div>
          <div class="prow"><span class="check">✓</span><span><b>No lock-in.</b> Assets are ordinary <code>.sql</code>, <code>.py</code>, and <code>.yml</code> files — if you stop using Renart, your pipelines are still right there.</span></div>
          <div class="prow"><span class="check">✓</span><span><b>Open source.</b> Apache 2.0, developed in the open.</span></div>
        </div>
      </section>

      <section class="final">
        <h2>From install to <em>scheduled pipeline</em> in one sitting.</h2>
        <p>Install Renart, open your repository, and go from first query to a scheduled, freshness-tracked pipeline without switching tools.</p>
        <div class="ctas">
          <a href="/docs/installation/" class="btn btn-primary">Get started</a>
          <a href={repoUrl} class="btn btn-ghost">View on GitHub <span class="arrow">-&gt;</span></a>
        </div>
        <div class="install install-final">
          <span class="install-cmd"><span class="prompt">$</span><span>{installCommand}</span></span>
          <button class="install-copy" type="button" data-copy-command={installCommand}>
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="4" y="4" width="9" height="9" rx="1.5" stroke="currentColor" stroke-width="1.4" /><path d="M3 11V4a1 1 0 011-1h7" stroke="currentColor" stroke-width="1.4" /></svg>
            <span class="copy-label">copy</span>
          </button>
        </div>
      </section>
    </main>

    <footer>
      <div class="footer-inner">
        <div class="foot-brand">
          <a href="/" class="logo">
            <img
              class="logo-mark"
              src="/icons/icon-32.png"
              srcset="/icons/icon-32.png 1x, /icons/icon-64.png 2x"
              alt=""
              width="22"
              height="22"
            />
            renart
          </a>
          <p>The whole data platform, in the box: scheduled, freshness-tracked pipelines from plain files in your repo. Public alpha, open source under Apache 2.0.</p>
        </div>
        <div class="foot-col">
          <h2>Product</h2>
          <ul>
            <li><a href="#difference">Why Renart</a></li>
            <li><a href="#lifecycle">Lifecycle</a></li>
            <li><a href="#features">Features</a></li>
            <li><a href="#principles">Principles</a></li>
          </ul>
        </div>
        <div class="foot-col">
          <h2>Resources</h2>
          <ul>
            <li><a href="/docs/">Docs</a></li>
            <li><a href="/docs/installation/">Installation</a></li>
            <li><a href="/docs/quickstart/">Quickstart</a></li>
          </ul>
        </div>
        <div class="foot-col">
          <h2>Community</h2>
          <ul>
            <li><a href={repoUrl}>GitHub</a></li>
            <li><a href={discordUrl}>Discord</a></li>
          </ul>
        </div>
      </div>
      <div class="foot-bottom">
        <span>© {currentYear} Renart / Apache 2.0</span>
        <div class="meta">
          <a href="/impressum/">Impressum</a>
          <a href="/datenschutz/">Datenschutzerklärung</a>
          <button type="button" data-open-privacy-settings>Privacy settings</button>
          <span>{latestVersion} / public alpha</span>
        </div>
      </div>
    </footer>

    <div class="toast" id="toast">copied to clipboard</div>
    <PrivacyConsent />

    <script is:inline>
      document.querySelectorAll('.install-copy').forEach((button) => {
        button.addEventListener('click', async () => {
          const command = button.getAttribute('data-copy-command') || '';
          await navigator.clipboard?.writeText(command);
          document.querySelectorAll('.install-copy').forEach((copyButton) => {
            copyButton.classList.add('copied');
            const label = copyButton.querySelector('.copy-label');
            if (label) label.textContent = 'copied';
            window.setTimeout(() => {
              copyButton.classList.remove('copied');
