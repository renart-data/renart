    <meta name="description" content={pageDescription} />
    <meta name="application-name" content="Renart" />
    <meta name="apple-mobile-web-app-title" content="Renart" />
    <meta name="theme-color" content="#0b0d0c" />
    <meta name="robots" content="index, follow" />
    <meta name="keywords" content="Renart, data pipelines, data pipeline tool, data pipeline scheduler, staleness tracking, incremental data builds, data lineage, SQL notebooks, git-native data pipelines, data engineering, analytics engineering" />
    <meta name="author" content="Renart" />
    <link rel="icon" href="/icons/icon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" sizes="180x180" />
