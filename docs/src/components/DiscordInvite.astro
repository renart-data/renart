---
const inviteUrl = 'https://discord.gg/jTH758KNP8';
---

<div class="discord-invite" data-discord-invite>
  <aside
    class="discord-invite__card"
    aria-labelledby="renart-discord-invite-title"
    data-discord-invite-card
    hidden
  >
    <button
      class="discord-invite__close"
      type="button"
      aria-label="Dismiss Discord invitation"
      data-discord-invite-dismiss
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
        <path d="M18 6 6 18M6 6l12 12"></path>
      </svg>
    </button>
    <p class="discord-invite__eyebrow"><span></span> Community</p>
    <h2 id="renart-discord-invite-title">Join us on Discord</h2>
    <p>Questions, bugs, or ideas? Meet other Renart users and help shape the project.</p>
    <a class="discord-invite__cta" href={inviteUrl} target="_blank" rel="noopener noreferrer">
      Open Discord
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" aria-hidden="true">
        <path d="M3 8h10M9 4l4 4-4 4"></path>
      </svg>
    </a>
  </aside>

  <a
    class="discord-invite__button"
    href={inviteUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Join Renart on Discord"
  >
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M20.317 4.369a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.249a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.036A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.197.373.291a.077.077 0 0 1-.006.127 12.3 12.3 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.331c-1.182 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"></path>
    </svg>
  </a>
</div>

<script is:inline>
  (() => {
    const storageKey = 'renart.discord-invite-dismissed.v1';

    document.querySelectorAll('[data-discord-invite]').forEach((root) => {
      if (root.hasAttribute('data-initialized')) return;
      root.setAttribute('data-initialized', 'true');

      const card = root.querySelector('[data-discord-invite-card]');
      const dismissButton = root.querySelector('[data-discord-invite-dismiss]');
      let dismissed = false;

      try {
        dismissed = window.localStorage.getItem(storageKey) === '1';
      } catch {
        dismissed = false;
      }

      if (!dismissed) card?.removeAttribute('hidden');

      dismissButton?.addEventListener('click', () => {
        card?.setAttribute('hidden', '');
        try {
          window.localStorage.setItem(storageKey, '1');
        } catch {
          // The invitation can still be dismissed for the current page.
        }
      });
    });
  })();
</script>

<style>
  .discord-invite {
    position: fixed;
    right: 1.35rem;
    bottom: 1.35rem;
    z-index: 80;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.75rem;
    font-family: var(--font-geist, system-ui, sans-serif);
  }

  .discord-invite__card {
    position: relative;
    width: min(18rem, calc(100vw - 2rem));
    padding: 1.1rem;
    color: #eef3ef;
    background: #111513;
    border: 1px solid #303834;
    border-radius: 0.75rem;
    box-shadow: 0 18px 55px rgb(0 0 0 / 38%);
    animation: discord-invite-enter 180ms ease-out;
  }

  .discord-invite__card[hidden] {
    display: none;
  }

  .discord-invite__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0 1.8rem 0.65rem 0;
    color: #66d49c;
    font-family: var(--font-geist-mono, ui-monospace, monospace);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .discord-invite__eyebrow span {
    width: 1.5rem;
    height: 1px;
    background: currentColor;
  }

  .discord-invite__card h2 {
    display: block;
    margin: 0 1.8rem 0.45rem 0;
    color: inherit;
    font-size: 1.05rem;
    line-height: 1.3;
  }

  .discord-invite__card > p:not(.discord-invite__eyebrow) {
    margin: 0 0 0.9rem;
    color: #aeb9b3;
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .discord-invite__close {
    position: absolute;
    top: 0.65rem;
    right: 0.65rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.8rem;
    height: 1.8rem;
    padding: 0;
    color: #7f8d85;
    background: transparent;
    border: 0;
    border-radius: 0.35rem;
    cursor: pointer;
  }

  .discord-invite__close:hover {
    color: #eef3ef;
    background: #202622;
  }

  .discord-invite__close:focus-visible,
  .discord-invite__cta:focus-visible,
  .discord-invite__button:focus-visible {
    outline: 2px solid #66d49c;
    outline-offset: 2px;
  }

  .discord-invite__close svg {
    width: 1rem;
    height: 1rem;
    stroke-width: 2;
    stroke-linecap: round;
  }

  .discord-invite__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.35rem;
    padding: 0.55rem 0.8rem;
    color: #07120b;
    background: #66d49c;
    border: 1px solid #66d49c;
    border-radius: 0.42rem;
    font-size: 0.8rem;
    font-weight: 650;
    text-decoration: none;
  }

  .discord-invite__cta:hover {
    color: #07120b;
    background: #7de0ac;
    border-color: #7de0ac;
  }

  .discord-invite__cta svg {
    width: 0.9rem;
    height: 0.9rem;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .discord-invite__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    height: 3.25rem;
    color: #66d49c;
    background: #111513;
    border: 1px solid #3b4740;
    border-radius: 0.7rem;
    box-shadow: 0 12px 34px rgb(0 0 0 / 35%);
    transition:
      transform 150ms ease,
      border-color 150ms ease,
      background 150ms ease;
  }

  .discord-invite__button:hover {
    color: #7de0ac;
    background: #18201c;
    border-color: #66d49c;
    transform: translateY(-2px);
  }

  .discord-invite__button svg {
    width: 1.65rem;
    height: 1.65rem;
  }

  @keyframes discord-invite-enter {
    from {
      opacity: 0;
      transform: translateY(0.4rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 40rem) {
    .discord-invite {
      right: 1rem;
      bottom: 1rem;
    }

    .discord-invite__card {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .discord-invite__card {
      animation: none;
    }

    .discord-invite__button {
      transition: none;
    }
  }
</style>
