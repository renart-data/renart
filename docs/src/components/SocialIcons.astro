---
// Starlight header override: an Install entry point ahead of the default
// social links (GitHub, Discord) configured in astro.config.mjs.
import Default from '@astrojs/starlight/components/SocialIcons.astro';
---

<a class="docs-install-link" href="/docs/installation/">Install</a>
<Default />

<style>
  .docs-install-link {
    align-self: center;
    margin-inline-end: 0.35rem;
    padding: 0.3rem 0.75rem;
    color: var(--sl-color-black);
    background: var(--sl-color-accent-high);
    border-radius: 0.4rem;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    line-height: 1.4;
    text-decoration: none;
    white-space: nowrap;
  }

  .docs-install-link:hover {
    background: var(--sl-color-white);
  }

  .docs-install-link:focus-visible {
    outline: 2px solid var(--sl-color-accent-high);
    outline-offset: 2px;
  }
</style>
