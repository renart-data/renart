---
interface Props { version?: string; }
const { version } = Astro.props;
const repoUrl = "https://github.com/renart-data/renart";
const discordUrl = "https://discord.gg/jTH758KNP8";
const currentYear = new Date().getFullYear();
---
    <footer class="landing-footer">
      <div class="landing-container">
        <p class="landing-mission">Bring a first-class developer experience to the entire data workflow.</p>
        <div class="landing-footer__main">
          <a href="/" class="landing-brand" aria-label="Renart home"><img src="/icons/icon-64.png" alt="" width="64" height="64" /><span>renart</span></a>
          <span class="landing-footer__version">{version ? `${version} · ` : ""}public alpha · Apache 2.0</span>
          <nav class="landing-footer__nav" aria-label="Footer navigation">
            <a href="/compare/">Compare</a><a href="/docs/">Docs</a><a href="/work-with-me/" aria-current={Astro.url.pathname === '/work-with-me/' ? 'page' : undefined}>Work with me</a><a href={repoUrl}>Star us on GitHub</a><a href={discordUrl}>Discord</a><a href="/#install">Install</a>
          </nav>
        </div>
        <div class="landing-footer__legal">
          <span>© {currentYear} Renart</span>
          <div class="landing-footer__meta"><a href="/legal-notice/">Legal notice</a><a href="/privacy/">Privacy policy</a><button type="button" data-open-privacy-settings hidden>Privacy settings</button></div>
        </div>
      </div>
    </footer>
