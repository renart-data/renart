---
import { Font } from 'astro:assets';
import PrivacyConsent from '../components/PrivacyConsent.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://getrenart.com');
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0b0d0c" />
    <link rel="icon" href="/icons/icon-32.png" type="image/png" sizes="32x32" />
    <link rel="canonical" href={canonical} />
    <title>{title} · Renart</title>
    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-geist-mono" />
  </head>
  <body>
    <header class="legal-nav">
      <a href="/" class="legal-logo" aria-label="Renart Startseite">
        <img src="/icons/icon-32.png" alt="" width="22" height="22" />
        renart
      </a>
      <nav aria-label="Seitennavigation">
        <a href="/docs/">Docs</a>
        <a href="https://discord.gg/jTH758KNP8">Discord</a>
      </nav>
    </header>

    <main>
      <p class="legal-eyebrow">Rechtliches</p>
      <h1>{title}</h1>
      <p class="legal-lead">{description}</p>
      <article class="legal-copy">
        <slot />
      </article>
    </main>

    <footer>
      <span>© {currentYear} Renart</span>
      <nav aria-label="Rechtliche Links">
        <a href="/impressum/">Impressum</a>
        <a href="/datenschutz/">Datenschutzerklärung</a>
        <button type="button" data-open-privacy-settings>Privacy settings</button>
      </nav>
    </footer>

    <PrivacyConsent />
  </body>
</html>

<style is:global>
  :root {
    --legal-bg: #0b0d0c;
    --legal-surface: #111513;
    --legal-line: #28302c;
    --legal-fg: #eef3ef;
    --legal-muted: #a5b0aa;
    --legal-accent: #66d49c;
    --sans: var(--font-geist), system-ui, sans-serif;
    --mono: var(--font-geist-mono), ui-monospace, monospace;
  }

  * {
    box-sizing: border-box;
  }

  html {
    color: var(--legal-fg);
    background: var(--legal-bg);
    font-family: var(--sans);
  }

  body {
    min-height: 100vh;
    margin: 0;
  }

  a {
    color: var(--legal-accent);
    text-underline-offset: 0.2em;
  }

  .legal-nav,
  body > footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: min(70rem, calc(100% - 2rem));
    margin: 0 auto;
  }

  .legal-nav {
    min-height: 4rem;
    border-bottom: 1px solid var(--legal-line);
  }

  .legal-nav nav,
  body > footer nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
  }

  .legal-nav a,
  body > footer a,
  body > footer button {
    color: var(--legal-muted);
    background: none;
    border: 0;
    font: inherit;
    font-size: 0.84rem;
    text-decoration: none;
  }

  body > footer button {
    padding: 0;
    cursor: pointer;
  }

  .legal-nav a:hover,
  body > footer a:hover,
  body > footer button:hover {
    color: var(--legal-fg);
  }

  body > footer [hidden] {
    display: none;
  }

  .legal-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--legal-fg) !important;
    font-family: var(--mono);
    font-size: 1rem !important;
    font-weight: 600;
  }

  .legal-logo img {
    display: block;
  }

  main {
    width: min(48rem, calc(100% - 2rem));
    margin: 0 auto;
    padding: 5rem 0 6rem;
  }

  .legal-eyebrow {
    margin: 0 0 0.9rem;
    color: var(--legal-accent);
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.3rem, 7vw, 4.3rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .legal-lead {
    max-width: 42rem;
    margin: 1.35rem 0 0;
    color: var(--legal-muted);
    font-size: 1.08rem;
    line-height: 1.65;
  }

  .legal-copy {
    margin-top: 3rem;
    padding: 0 2rem 2rem;
    background: var(--legal-surface);
    border: 1px solid var(--legal-line);
    border-radius: 0.75rem;
  }

  .legal-copy h2 {
    margin: 2.2rem 0 0.75rem;
    color: var(--legal-fg);
    font-size: 1.2rem;
    letter-spacing: -0.015em;
  }

  .legal-copy h3 {
    margin: 1.6rem 0 0.6rem;
    color: var(--legal-fg);
    font-size: 1rem;
  }

  .legal-copy p,
  .legal-copy li,
  .legal-copy address {
    color: var(--legal-muted);
    font-size: 0.94rem;
    line-height: 1.7;
  }

  .legal-copy address {
    font-style: normal;
  }

  .legal-copy strong {
    color: var(--legal-fg);
  }

  .legal-copy ul {
    padding-left: 1.25rem;
  }

  body > footer {
    padding: 1.5rem 0 2.5rem;
    color: var(--legal-muted);
    border-top: 1px solid var(--legal-line);
    font-family: var(--mono);
    font-size: 0.76rem;
  }

  @media (max-width: 36rem) {
    .legal-nav,
    body > footer {
      align-items: flex-start;
      flex-direction: column;
      padding-block: 1rem;
    }

    main {
      padding-block: 3.5rem 4rem;
    }

    .legal-copy {
      padding-inline: 1.2rem;
    }
  }
</style>
