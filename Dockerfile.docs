# syntax=docker/dockerfile:1

FROM node:26-alpine@sha256:aadf416b2cdce311a8811ba3f0608a61b77dbf997500e2eafe781b51f6a0b019 AS build

WORKDIR /app

ARG RENART_VERSION
ARG RENART_COMMIT
ENV RENART_VERSION=${RENART_VERSION}
ENV RENART_COMMIT=${RENART_COMMIT}

RUN corepack enable && corepack prepare pnpm@10.33.0 --activate

COPY docs/package.json docs/pnpm-lock.yaml ./docs/
WORKDIR /app/docs
RUN pnpm install --frozen-lockfile

WORKDIR /app
COPY docs ./docs
COPY web/public/icons/icon-64.png ./web/public/icons/icon-64.png

WORKDIR /app/docs
RUN pnpm build

FROM caddy:2-alpine@sha256:5f5c8640aae01df9654968d946d8f1a56c497f1dd5c5cda4cf95ab7c14d58648 AS runtime

COPY docs/Caddyfile /etc/caddy/Caddyfile
COPY docs/container-entrypoint.sh /usr/local/bin/renart-docs-entrypoint
COPY --from=build /app/docs/dist /usr/share/caddy
RUN chmod +x /usr/local/bin/renart-docs-entrypoint

EXPOSE 80

ENTRYPOINT ["renart-docs-entrypoint"]
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
