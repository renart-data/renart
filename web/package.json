{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "generate:api-types": "node ./scripts/generate-api-types.mjs",
    "generate:icons": "node ./scripts/generate-icons.mjs",
    "sync:polyglot-wasm": "node ./scripts/sync-polyglot-wasm.mjs",
    "typecheck": "corepack pnpm run generate:api-types && tsc --noEmit",
    "build": "corepack pnpm run generate:icons && corepack pnpm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "corepack pnpm format:check && corepack pnpm lint && corepack pnpm build",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:live": "corepack pnpm build && PWTEST_CACHE_DIR=/dev/shm/bruin-playwright/cache playwright test --config=playwright.live.config.ts",
    "docs:screenshots": "corepack pnpm build && node ./scripts/capture-onboarding-screenshots.mjs",
    "landing:media": "corepack pnpm build && node ./scripts/capture-landing-media.mjs",
    "docs:media": "corepack pnpm build && node ./scripts/capture-docs-media.mjs",
    "tutorial:quick-tour": "corepack pnpm build && node ./scripts/tutorials/render-tutorial.mjs ./scripts/tutorials/tutorial-01-quick-tour.json",
    "tutorial:build-pipeline": "corepack pnpm build && node ./scripts/tutorials/render-tutorial.mjs ./scripts/tutorials/tutorial-02-build-a-pipeline.json",
    "audit": "pnpm audit --audit-level=high"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-form": "^1.33.1",
    "@tanstack/react-router": "^1.170.17",
    "@tanstack/react-virtual": "^3.14.5",
    "ansi-to-html": "^0.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dagre": "^0.8.5",
    "jotai": "^2.20.1",
    "lucide-react": "^1.24.0",
    "radix-ui": "^1.6.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.81.0",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.1",
    "reactflow": "^11.11.4",
    "recharts": "3.9.2",
    "shadcn": "^4.13.0",
    "swr": "^2.4.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@polyglot-sql/sdk": "0.5.15",
    "@tailwindcss/postcss": "^4.3.2",
    "@tanstack/router-plugin": "^1.168.19",
    "@types/dagre": "^0.7.54",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "monaco-editor": "0.55.1",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.74.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.1.4"
  }
}
