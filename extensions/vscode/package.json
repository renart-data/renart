{
  "name": "renart-sql-lsp",
  "displayName": "Renart SQL LSP",
  "description": "Experimental SQL language-server client for Renart projects.",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "publisher": "renart",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:sql",
    "workspaceContains:dbt_project.yml",
    "workspaceContains:dbt_project.yaml",
    "workspaceContains:**/pipeline.yml",
    "workspaceContains:**/pipeline.yaml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Renart SQL LSP",
      "properties": {
        "renartSqlLsp.serverPath": {
          "type": "string",
          "default": "renart",
          "description": "Path to the Renart executable that provides the sql-lsp command."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -w -p .",
    "typecheck": "tsc --noEmit -p .",
    "audit": "pnpm audit --audit-level=low"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/vscode": "^1.134.0",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "5.0.9"
    }
  }
}
